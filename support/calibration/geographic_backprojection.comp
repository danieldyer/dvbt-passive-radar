#version 450
layout(local_size_x=64) in;
// Geometry is evaluated in double precision on the host. Each entry stores
// a profile coordinate and exp(+j k L), including a known calibration phase.
layout(set=0,binding=0,std430) readonly buffer Geometry {vec4 geometry[];};
layout(set=0,binding=1,std430) readonly buffer Profiles {vec2 profile[];};
layout(set=0,binding=2,std430) readonly buffer Weights {vec4 weight[];};
layout(set=0,binding=3,std430) readonly buffer Interpolation {float coefficient[];};
layout(set=0,binding=4,std430) writeonly buffer Image {vec4 result[];};
layout(push_constant) uniform Parameters {uint pixels;uint channels;uint phases;uint unused;} p;
vec2 multiply(vec2 a,vec2 b){return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
void main(){
    uint pixel=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;
    if(pixel>=p.pixels)return;
    vec2 sum=vec2(0);float independent=0,information=0;
    for(uint channel=0;channel<p.channels;++channel){
        vec4 g=geometry[pixel*p.channels+channel],w=weight[channel];
        if(g.w==0 || w.x<=0)continue;
        int base=int(floor(g.x));float fraction=fract(g.x)*p.phases;
        uint phase=min(uint(fraction),p.phases-1);float mix_fraction=fraction-phase;
        vec2 z=vec2(0);
        for(int tap=0;tap<64;++tap){
            int lag=base+tap-31;
            // Export contains negative context -64..-1 and positive 0..928.
            if(lag < -64 || lag>928)continue;
            float a=coefficient[phase*64+tap],b=coefficient[(phase+1)*64+tap];
            z+=mix(a,b,mix_fraction)*profile[channel*1024+uint((lag+1024)%1024)];
        }
        vec2 corrected=multiply(z,g.yz);
        sum+=multiply(corrected,w.yz)*w.x;
        information+=dot(w.yz,w.yz)*w.w*w.x;
        independent+=dot(z,z)*w.x/w.w;
    }
    // z=sum(g* q / variance); information=sum(|g|^2 template_energy).
    // w=(inverse covariance scale, conjugated complex gain, template PSF(0)).
    result[pixel]=vec4(sum,independent,information);
}
