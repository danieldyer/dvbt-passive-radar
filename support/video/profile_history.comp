#version 450
layout(local_size_x=64) in;
layout(binding=0) readonly buffer Batch {vec2 input_values[];};
layout(binding=1) buffer History {vec2 history[];};
layout(binding=2) readonly buffer Valid {uint valid[];};
layout(binding=3) writeonly buffer Snapshot {vec2 output_values[];};
layout(push_constant) uniform Parameters {uint rows,size,capacity,first,mode;} p;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=2*p.rows*p.size)return;
    uint k=i%p.size,row=i/p.size%p.rows,moment=i/(p.rows*p.size);
    uint j=(moment*p.capacity+(p.first+row)%p.capacity)*p.size+k;
    if(p.mode==0)history[j]=input_values[i];
    else output_values[i]=valid[row]!=0 ? history[j] : vec2(0);
}
