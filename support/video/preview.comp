#version 450
layout(local_size_x=64) in;
layout(binding=0) readonly buffer Input {vec2 values[];};
layout(binding=1) readonly buffer RangeNoise {float range_noise[];};
layout(binding=2) readonly buffer DopplerNoise {float doppler_noise[];};
layout(binding=3) writeonly buffer Output {float power[];};
layout(binding=4) buffer Status {uint invalid;};
layout(push_constant) uniform Parameters {uint ranges,frequencies,range_stride,frequency_stride,width,height,normalize;} p;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=p.width*p.height)return;
    uint r0=(i%p.width)*p.range_stride,f0=(p.height-1-i/p.width)*p.frequency_stride;
    float maximum=0;
    for(uint r=r0;r<min(r0+p.range_stride,p.ranges);++r)
        for(uint f=f0;f<min(f0+p.frequency_stride,p.frequencies);++f){
            vec2 z=values[r*p.frequencies+f];
            if(any(isnan(z)) || any(isinf(z)))atomicOr(invalid,1);
            // Match CPU amplitude scaling before squaring. Never overwrite the
            // scientific complex samples or their phase.
            if(p.normalize!=0)z*=inversesqrt(range_noise[r])*inversesqrt(doppler_noise[f]);
            if(any(isnan(z)) || any(isinf(z)))atomicOr(invalid,1);
            float value=dot(z,z);
            if(isnan(value) || isinf(value))atomicOr(invalid,1);
            maximum=max(maximum,value);
        }
    power[i]=maximum;
}
