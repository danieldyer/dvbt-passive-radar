enable_language(OBJCXX)
find_package(glfw3 3.3 CONFIG REQUIRED)
set(imgui_archive "https://codeload.github.com/ocornut/imgui/tar.gz/refs/tags/v1.91.9b")
set(implot_archive "https://codeload.github.com/epezent/implot/tar.gz/refs/tags/v0.16")
foreach(package imgui implot)
    if(EXISTS "${PROJECT_SOURCE_DIR}/build/downloads/${package}.tar.gz")
        set(${package}_archive "${PROJECT_SOURCE_DIR}/build/downloads/${package}.tar.gz")
    endif()
endforeach()
FetchContent_Declare(imgui URL "${imgui_archive}" URL_HASH SHA256=8e1bbc76c71d74fef2fb85db7e7ca8eba13d6a86623c54992b60162db554ffdb)
FetchContent_Declare(implot URL "${implot_archive}" URL_HASH SHA256=961df327d8a756304d1b0a67316eebdb1111d13d559f0d3415114ec0eb30abd1)
FetchContent_MakeAvailable(imgui implot)
add_library(radar_imgui STATIC
    "${imgui_SOURCE_DIR}/imgui.cpp" "${imgui_SOURCE_DIR}/imgui_draw.cpp"
    "${imgui_SOURCE_DIR}/imgui_tables.cpp" "${imgui_SOURCE_DIR}/imgui_widgets.cpp"
    "${imgui_SOURCE_DIR}/backends/imgui_impl_glfw.cpp" "${imgui_SOURCE_DIR}/backends/imgui_impl_metal.mm"
    "${implot_SOURCE_DIR}/implot.cpp" "${implot_SOURCE_DIR}/implot_items.cpp")
target_include_directories(radar_imgui SYSTEM PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends" "${implot_SOURCE_DIR}")
target_link_libraries(radar_imgui PUBLIC glfw "-framework Metal" "-framework QuartzCore" "-framework AppKit")
target_compile_options(radar_imgui PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
add_library(radar_native_display support/live/native_display.mm)
target_include_directories(radar_native_display PUBLIC support/live)
target_link_libraries(radar_native_display PUBLIC radar_video_preview PRIVATE radar_imgui)
target_compile_options(radar_native_display PRIVATE -Wall -Wextra -Wpedantic -fobjc-arc)
set_target_properties(radar_native_display radar_imgui PROPERTIES CXX_EXTENSIONS OFF OBJCXX_EXTENSIONS OFF OBJCXX_STANDARD 23 OBJCXX_STANDARD_REQUIRED YES)
target_compile_definitions(dvbt_capture PRIVATE RADAR_NATIVE_DISPLAY)
target_link_libraries(dvbt_capture PRIVATE radar_native_display)
add_executable(native_display_check EXCLUDE_FROM_ALL support/live/native_display_check.cpp)
target_link_libraries(native_display_check PRIVATE radar_native_display)
