#version 450
layout(local_size_x=64) in;
layout(set=0,binding=4,std430) readonly buffer Partial {float partial[];};
layout(set=0,binding=5,std430) writeonly buffer Output {float gradient[];};
layout(push_constant) uniform Parameters {
    uint stride;uint bands;uint cells;uint degree;uint pixels;uint blocks;
    int first_cell;uint block_rows;float symbol_duration;uint derivatives;uint derivative_mode;
} p;
void main(){
    uint row=gl_GlobalInvocationID.x;if(row>=p.stride*p.bands)return;
    uint tiles=(p.pixels+2047)/2048;
    for(uint j=0;j<p.derivatives;++j){float sum=0;for(uint tile=0;tile<tiles;++tile)sum+=partial[(row*tiles+tile)*p.derivatives+j];gradient[row*p.derivatives+j]=sum;}
}
