#version 450
layout(local_size_x=64) in;
layout(set=0,binding=4,std430) readonly buffer Partial {vec2 partial[];};
layout(set=0,binding=5,std430) writeonly buffer Output {vec2 image[];};
layout(push_constant) uniform Parameters {
    uint stride;uint bands;uint cells;uint degree;uint pixels;uint blocks;
    int first_cell;uint block_rows;float symbol_duration;uint derivatives;uint derivative_mode;
} p;
void main(){
    uint at=gl_GlobalInvocationID.x,band=gl_WorkGroupID.y;if(at>=p.pixels)return;
    uint width=p.derivative_mode>0 ? p.derivatives+1 : 1;
    for(uint j=0;j<width;++j){
        vec2 sum=vec2(0);for(uint b=0;b<p.blocks;++b)sum+=partial[((band*p.blocks+b)*width+j)*p.pixels+at];
        image[(band*width+j)*p.pixels+at]=sum;
    }
}
