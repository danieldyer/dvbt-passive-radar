#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "focus_sample.glsl"
layout(set=0,binding=3,std430) readonly buffer Cotangent {vec2 cotangent[];};
layout(set=0,binding=4,std430) writeonly buffer Partial {float partial[];};
shared float sums[512];
void main(){
    uint row=gl_WorkGroupID.y,lane=gl_LocalInvocationID.x;
    uint tile=gl_WorkGroupID.x,tiles=(p.pixels+2047)/2048,band=row/p.stride;
    float sum[8];for(uint j=0;j<p.derivatives;++j)sum[j]=0;
    for(uint at=tile*2048+lane;at<min((tile+1)*2048,p.pixels);at+=64){
        vec2 value[9];sample_row(row,pixel[at].xyz,value);
        vec2 weight=cotangent[band*p.pixels+at];
        for(uint j=0;j<p.derivatives;++j)sum[j]+=2*dot(weight,value[j+1]);
    }
    for(uint j=0;j<p.derivatives;++j)sums[j*64+lane]=sum[j];barrier();
    for(uint size=32;size>0;size/=2){
        if(lane<size)for(uint j=0;j<p.derivatives;++j)sums[j*64+lane]+=sums[j*64+lane+size];barrier();
    }
    if(lane==0)for(uint j=0;j<p.derivatives;++j)partial[(row*tiles+tile)*p.derivatives+j]=sums[j*64];
}
