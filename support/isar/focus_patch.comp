#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
#include "focus_sample.glsl"
layout(set=0,binding=4,std430) writeonly buffer Partial {vec2 partial[];};
void main(){
    uint at=gl_GlobalInvocationID.x,block=gl_WorkGroupID.y;
    if(at>=p.pixels)return;
    uint band=block/p.blocks,local_block=block%p.blocks;
    uint width=p.derivative_mode>0 ? p.derivatives+1 : 1;
    vec2 sum[9];for(uint j=0;j<width;++j)sum[j]=vec2(0);
    for(uint row=band*p.stride+local_block*p.block_rows;row<band*p.stride+min((local_block+1)*p.block_rows,p.stride);++row){
        vec2 value[9];sample_row(row,pixel[at].xyz,value);
        for(uint j=0;j<width;++j)sum[j]+=value[j];
    }
    for(uint j=0;j<width;++j)partial[(block*width+j)*p.pixels+at]=sum[j];
}
