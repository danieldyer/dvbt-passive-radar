#version 450
layout(local_size_x=64) in;
layout(set=0,binding=4,std430) readonly buffer Partial {vec4 partial[];};
layout(set=0,binding=5,std430) writeonly buffer Image {vec4 result[];};
layout(push_constant) uniform Parameters {
    uint rows; uint ranges; uint pixels; uint phases;
    uint block_rows; uint blocks; float k; float symbol_duration;
} p;
void main(){
    uint pixel=gl_GlobalInvocationID.x;
    if(pixel>=p.pixels)return;
    vec4 sum=vec4(0),error=vec4(0);
    for(uint block=0;block<p.blocks;++block){
        vec4 y=partial[block*p.pixels+pixel]-error,t=sum+y;
        error=(t-sum)-y;sum=t;
    }
    result[pixel]=sum;
}
