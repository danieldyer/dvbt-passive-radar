#version 450
layout(local_size_x=64) in;
layout(set=0,binding=1,std430) readonly buffer Phases {vec2 phases[];};
layout(set=0,binding=3,std430) buffer Measured {vec2 measured[];};
layout(set=0,binding=5,std430) buffer Pilots {vec2 stats[];};
layout(push_constant) uniform Parameters {uint count;uint pilots;uint unused0;uint unused1;} pc;
vec2 multiply(vec2 a,vec2 b){return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
void main() {
    uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;
    if(i>=pc.count*6817)return;
    uint w=i/6817,k=i%6817;
    measured[i]=multiply(measured[i],phases[w]);
    if(k<pc.pilots) {
        uint at=w*(pc.pilots+3)+2+k;stats[at]=multiply(stats[at],phases[w]);
    }
}
