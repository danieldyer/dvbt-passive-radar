#version 450
layout(local_size_x=64) in;
layout(constant_id=0) const uint m=6;
layout(set=0,binding=1,std430) readonly buffer Mapping {uint mapping[];};
layout(set=0,binding=2,std430) readonly buffer Codes {uint codes[];};
layout(set=0,binding=3,std430) writeonly buffer Carriers {vec2 carriers[];};
layout(set=0,binding=4,std430) writeonly buffer Valid {uint valid[];};
layout(set=0,binding=5,std430) readonly buffer Signalling {float tps_sign[];};
layout(set=0,binding=6,std430) readonly buffer Constants {vec2 table[];};
layout(push_constant) uniform Parameters {uint bits;uint count;uint packets;uint row_bits;} pc;
void main() {
    uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;
    if(i>=pc.count*6817)return;
    uint s=i/6817,k=i%6817,base=((s%4)*6817+k)*m;
    if(mapping[base]==0xffffffffU) {
        vec2 pilot=table[64+k];
        carriers[i]=vec2(pilot.y==0 ? pilot.x : pilot.x*.75*tps_sign[s],0);
        valid[i]=1;return;
    }
    uint label=0,good=1;
    for(uint e=0;e<m;++e) {
        uint at=2*s*pc.row_bits+mapping[base+e],word=(codes[at/16]>>(4*((at/2)%8)))&7U;
        label=(label<<1)|((word>>(at%2))&1U);good&=uint((word&4U)!=0);
    }
    carriers[i]=vec2(table[label].x,table[label].y);
    valid[i]=good;
}
