#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Measured {vec2 y[];};
layout(set=0,binding=1,std430) readonly buffer Reference {vec2 x[];};
layout(set=0,binding=2,std430) readonly buffer Valid {uint valid[];};
layout(set=0,binding=5,std430) writeonly buffer Applied {float applied[];};
layout(set=0,binding=6,std430) buffer History {float history[];};
layout(set=0,binding=7,std430) writeonly buffer Training {vec4 training[];};
layout(push_constant) uniform Parameters {uint first;uint last;uint ready;uint unused;} pc;
vec2 mul(vec2 a,vec2 b){return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
void main() {
    uint k=gl_GlobalInvocationID.x;if(k>=6817)return;
    vec2 mean=vec2(0);float power=0,count=0,scatter=0;
    for(uint row=pc.first;row<pc.last;++row) {
        uint i=row*6817+k;float p=dot(x[i],x[i]);
        if(valid[i]==0 || p<=0)continue;
        vec2 r=mul(y[i],vec2(x[i].x,-x[i].y))/p;
        float total=power+p;vec2 delta=r-mean;
        mean+=delta*(p/total);scatter+=dot(delta,delta)*p*(power/total);
        power=total;count+=1;
    }
    float prior=pc.ready!=0 ? history[k] : 1e-30;
    // Source-conditioned WLS removes one complex, stationary carrier transfer.
    // E[sum(p*|r-mean|^2)] = (count-1)*D for independent innovations D/p.
    // Other phase/gain/timing variation remains in the estimate: it must not be
    // silently projected away while still present in the primary observations.
    float estimate=count>1 ? max(scatter/(count-1),1e-30) : prior;
    applied[k]=pc.ready!=0 ? prior : estimate;history[k]=estimate;
    training[k]=vec4(mean,count>1 ? power : 0,estimate);
}
