#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { vec2 samples[]; };
layout(set=0,binding=1,std430) readonly buffer Coefficients { float weights[]; };
layout(set=0,binding=2,std430) readonly buffer Coordinates { vec2 anchors[]; };
layout(set=0,binding=3,std430) writeonly buffer Output { vec2 result[]; };
layout(push_constant) uniform Parameters { uint count; float delta; } p;
void main() {
    uint m=gl_GlobalInvocationID.x;
    if(m>=p.count) return;
    vec2 anchor=anchors[gl_WorkGroupID.x];
    // Integer and fractional parts stay separate: never round a large time to FP32.
    float frac=anchor.y+float(gl_LocalInvocationID.x)*p.delta;
    int shift=int(floor(frac));
    float phase=(frac-float(shift))*2048.0;
    uint branch=min(2047u,uint(phase));
    float blend=phase-float(branch);
    int start=int(m)+floatBitsToInt(anchor.x)+shift-47;
    vec2 a=vec2(0), b=vec2(0), c=vec2(0), d=vec2(0);
    for(uint j=0;j<96;j+=4) {
        a+=samples[start+int(j)]*mix(weights[branch*96+j],weights[(branch+1)*96+j],blend);
        b+=samples[start+int(j+1)]*mix(weights[branch*96+j+1],weights[(branch+1)*96+j+1],blend);
        c+=samples[start+int(j+2)]*mix(weights[branch*96+j+2],weights[(branch+1)*96+j+2],blend);
        d+=samples[start+int(j+3)]*mix(weights[branch*96+j+3],weights[(branch+1)*96+j+3],blend);
    }
    result[m]=(a+b)+(c+d);
}
