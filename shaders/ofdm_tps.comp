#version 450
layout(local_size_x=64) in;
layout(set=0,binding=3,std430) readonly buffer Measured {vec2 measured[];};
layout(set=0,binding=4,std430) readonly buffer Equalized {vec2 equalized[];};
layout(set=0,binding=5,std430) buffer Statistics {vec2 stats[];};
layout(set=0,binding=6,std430) readonly buffer Tables {vec2 table[];};
layout(push_constant) uniform Parameters {uint count;uint capacity;uint pilots;uint tps;} pc;
shared vec4 reduction[64];
void main() {
    uint w=gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
    vec2 sum=vec2(0);float weight=0;
    for(uint j=lane;j<pc.tps;j+=64) {
        vec2 descriptor=table[2*6817+pc.pilots+j];uint k=floatBitsToUint(descriptor.x);
        vec2 z=equalized[w*6817+k],y=measured[w*6817+k];
        // The equalizer's complex channel estimate gives |H|^2 = |Y/Z|^2.
        // Weight repeated TPS carriers by their gain rather than amplifying fades.
        float gain=dot(y,y)/max(dot(z,z),1e-20);
        if(any(isnan(z)) || any(isinf(z)) || isnan(gain) || isinf(gain))continue;
        sum+=z*(descriptor.y*gain);weight+=gain;
    }
    reduction[lane]=vec4(sum,weight,0);barrier();
    for(uint step=32;step>0;step/=2){if(lane<step)reduction[lane]+=reduction[lane+step];barrier();}
    if(lane==0)stats[w*(pc.pilots+3)+pc.pilots+2]=reduction[0].xy/max(reduction[0].z,1e-30);
}
