#version 450
// Coalesce across adjacent range-frequency columns. Each column has eight
// compensated partial sums; padding/mean projection remain the same operator.
layout(local_size_x=32,local_size_y=8) in;
layout(binding=0) readonly buffer Input {vec2 profiles[];};
layout(binding=7) writeonly buffer Means {vec2 means[];};
layout(binding=9) readonly buffer Weights {float weights[];};
layout(push_constant) uniform Parameters {uint rows,size,frequencies,first,count,ranges;int offset_bin;uint remove_dc;float interval,rf;uint profile_size;} p;
shared vec2 partial[256];
void main(){
    uint x=gl_LocalInvocationID.x,y=gl_LocalInvocationID.y,k=gl_WorkGroupID.x*32+x,moment=gl_WorkGroupID.y;
    precise vec2 sum=vec2(0),correction=vec2(0);
    if(p.remove_dc!=0 && k<p.profile_size)for(uint n=y;n<p.rows;n+=8){
        precise vec2 term=weights[n]*profiles[(moment*p.rows+n)*p.profile_size+k]-correction;
        precise vec2 next=sum+term;
        correction=(next-sum)-term;sum=next;
    }
    partial[y*32+x]=sum;barrier();
    for(uint step=4;step>0;step/=2){if(y<step)partial[y*32+x]+=partial[(y+step)*32+x];barrier();}
    if(y==0 && k<p.profile_size)means[moment*p.profile_size+k]=partial[x]/float(p.rows);
}
