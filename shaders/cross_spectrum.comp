#version 450

layout(local_size_x = 128) in;
layout(push_constant) uniform Parameters { uint count; } params;
// Three contiguous complex-float arrays: reference, surveillance, cross spectrum.
layout(set = 0, binding = 0, std430) buffer Samples { vec2 iq[]; } samples;

void main()
{
    uint k = gl_GlobalInvocationID.x;
    if (k >= params.count) {
        return;
    }
    vec2 r = samples.iq[k];
    vec2 s = samples.iq[params.count + k];
    // S[k] * conj(R[k]); preserve phase for the subsequent delay IFFT.
    samples.iq[2 * params.count + k] = vec2(
        s.x * r.x + s.y * r.y,
        s.y * r.x - s.x * r.y
    );
}
