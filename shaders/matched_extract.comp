#version 450
layout(local_size_x=64) in;
layout(binding=6) readonly buffer Correlation {vec2 correlation[];};
layout(binding=7) writeonly buffer Profiles {vec2 profiles[];};
layout(binding=10) readonly buffer SourceClock {vec4 coordinate[];};
layout(binding=11) readonly buffer Prefix {vec2 prefix[];};
layout(push_constant) uniform Parameters {uint start,count,total,capacity,guard;int origin;float fraction,gain;uint cancel_direct,output_count,output_first,size;} p;
void main(){
    uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;
    if(i>=p.capacity*1024)return;
    uint row=i/1024,range=i%1024;if(row>=p.count)return;
    vec2 zero=vec2(0),one=vec2(0);
    if(range<=928 || range>=960){
        int lag=range<=928 ? int(range) : int(range)-1024;
        uint bin=uint((lag+8192)%8192),stride=p.capacity*8192;
        zero=correlation[row*8192+bin];one=correlation[stride+row*8192+bin];
        // Circular correlation is exact inside the guard. Replace only the
        // short prefix belonging to the previous symbol: an exact finite CAF.
        int origin=int(coordinate[p.start+row].x);
        int cp=int(8192/p.guard),end=max(0,origin+lag-cp);
        if(end>0){
            // Exact linear convolution of the short error prefix with the
            // reversed previous-minus-current reference. Zero padding, not
            // circular extension, preserves echoes beyond the guard interval.
            zero+=prefix[row*p.size+uint(end)];
            one+=prefix[(p.capacity+row)*p.size+uint(end)];
        }
    }
    uint at=(p.start-p.output_first+row)*1024+range;
    profiles[at]=zero/p.gain;profiles[p.output_count*1024+at]=one/p.gain;
}
