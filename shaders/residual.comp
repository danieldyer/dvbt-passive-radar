#version 450
layout(local_size_x=128) in;
layout(set=0,binding=0,std430) buffer Samples { vec2 v[]; };
layout(push_constant) uniform Dimensions { uint count; uint bins; } p;
vec2 multiply(vec2 a,vec2 b) { return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x); }
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=p.count)return;
    vec2 reference=v[p.count+i];
    vec2 response=v[2*p.count+i%p.bins];
    vec2 error=v[i]-multiply(response,reference);
    v[2*p.count+p.bins+i]=multiply(error,vec2(reference.x,-reference.y));
}
