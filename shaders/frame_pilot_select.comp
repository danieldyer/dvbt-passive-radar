#version 450
layout(local_size_x=128) in;
layout(constant_id=0) const uint maximum_radius=32;
layout(binding=9) buffer Channel {vec2 channel[];};
layout(push_constant) uniform Parameters {uint count,stride,bits,capacity;} pc;
shared vec4 partial[128];
shared float wide[128];
void main(){
    if(pc.count<=64){if(gl_LocalInvocationID.x==0)channel[pc.count*(3*2273+2)+128]=vec2(8,0);return;}
    uint lane=gl_LocalInvocationID.x;vec4 sum=vec4(0);float sum64=0;
    for(uint j=lane;j<2273;j+=128){sum+=vec4(channel[j],channel[2273+j]);if(maximum_radius>=64 && pc.count>128)sum64+=channel[2*2273+j].x;}
    partial[lane]=sum;if(maximum_radius>=64)wide[lane]=sum64;barrier();
    for(uint n=64;n>0;n/=2){if(lane<n){partial[lane]+=partial[lane+n];if(maximum_radius>=64)wide[lane]+=wide[lane+n];}barrier();}
    if(lane==0){
        // Short batches use the conservative existing radius. Ties prefer the
        // shorter support. The decision has its own cell, outside output grids.
        uint radius=8;
        if(pc.count>64){vec4 e=partial[0];uint best=0;for(uint j=1;j<4;++j)if(e[j]<e[best])best=j;radius=4<<best;
            if(maximum_radius>=64 && pc.count>128 && wide[0]<e[best])radius=64;}
        channel[pc.count*(3*2273+2)+128]=vec2(radius,0);
    }
}
