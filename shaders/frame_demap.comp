#version 450
layout(local_size_x=64,local_size_x_id=3) in;
layout(constant_id=0) const uint qam_bits=6;
layout(constant_id=1) const uint soft_metrics=0;
layout(constant_id=2) const uint cache_row=0;
layout(binding=1) readonly buffer Labels {uint labels[];};
layout(binding=5) readonly buffer Pilots {vec2 pilots[];};
layout(binding=10) readonly buffer Mapping {uint mapping[];};
layout(binding=11) writeonly buffer Bits {uint bits[];};
layout(push_constant) uniform Parameters {uint count,stride,bits,capacity;} pc;
shared uint cached_labels[cache_row!=0 ? 6817 : 1];
void gather_word(uint row,uint offset){
    uint row_bits=6048*qam_bits,mod=floatBitsToUint(pilots[row*pc.stride].x);
    uint first=mod*row_bits+4*offset;
    uint packed=0;
    for(uint b=0;b<4;++b){
        uint index=mapping[first+b];
        uint value=cache_row!=0 ? cached_labels[index/8] : labels[row*6817+index/8];
        uint observation=soft_metrics!=0 ? (value>>(4*(index%8)))&15U : value==255 ? 2 : (value>>(index%8))&1U;
        packed|=observation<<(8*b);
    }
    bits[row*(row_bits/4)+offset]=packed;
}
void main(){
    uint group=gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x;
    if(cache_row!=0){
        if(group>=pc.count)return;
        for(uint k=gl_LocalInvocationID.x;k<6817;k+=gl_WorkGroupSize.x)cached_labels[k]=labels[group*6817+k];
        barrier();
        for(uint word=gl_LocalInvocationID.x;word<6048*qam_bits/4;word+=gl_WorkGroupSize.x)gather_word(group,word);
    }else{
        uint word=group*gl_WorkGroupSize.x+gl_LocalInvocationID.x,row_words=6048*qam_bits/4;
        if(word>=pc.count*row_words)return;
        gather_word(word/row_words,word%row_words);
    }
}
