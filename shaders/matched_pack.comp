#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Measured {vec2 y[];};
layout(set=0,binding=1,std430) readonly buffer Reference {vec2 x[];};
layout(set=0,binding=2,std430) readonly buffer Valid {uint valid[];};
layout(set=0,binding=3,std430) readonly buffer Response {vec2 h[];};
layout(set=0,binding=4,std430) readonly buffer Noise {float variance[];};
layout(set=0,binding=5,std430) writeonly buffer Samples {vec2 samples[];};
layout(set=0,binding=8,std430) readonly buffer Rotations {vec2 rotations[];};
layout(set=0,binding=9,std430) readonly buffer Stationary {vec2 stationary[];};
layout(push_constant) uniform Parameters {uint start;uint count;uint total;uint capacity;uint guard;int origin;float fraction;float gain;uint cancel_direct;} pc;
vec2 mul(vec2 a,vec2 b){return vec2(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);}
vec2 rotation(float angle){return vec2(cos(angle),sin(angle));}
void main() {
    uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*64+gl_LocalInvocationID.x;
    uint stride=(pc.capacity+1)*8192;if(i>=2*stride)return;
    uint plane=i/stride,row=(i%stride)/8192,bin=i%8192;
    int k=bin<4096 ? int(bin) : int(bin)-8192;
    uint source=pc.start-1+row;vec2 value=vec2(0);
    if(abs(k)<=3408 && row<=pc.count && source<pc.total) {
        uint carrier=uint(k+3408),at=source*6817+carrier;
        if(valid[at]!=0) {
            if(plane==0) {
                float power=dot(x[at],x[at]);float balance=abs(power-16.0/9)<1e-5 ? 9.0/16 : 1;
                value=balance*mul(x[at],rotations[carrier]);
            } else {
                vec2 aligned=mul(x[at],rotations[6817+carrier]);
                vec2 direct=mul(h[carrier],aligned);
                direct=mul(vec2(1,0)+stationary[carrier],direct);
                vec2 error=y[at]-((pc.cancel_direct&1)!=0 ? direct : vec2(0));
                value=mul(error,vec2(h[carrier].x,-h[carrier].y))/max(variance[carrier],1e-30);
            }
        }
    }
    samples[i]=value;
}
