function(radar_test target source library)
    add_executable(${target} ${source})
    target_link_libraries(${target} PRIVATE radar_reference ${library})
endfunction()
function(radar_case name target label)
    add_test(NAME ${name} COMMAND ${target} ${ARGN})
    set_tests_properties(${name} PROPERTIES LABELS ${label} TIMEOUT 600
        ENVIRONMENT "TMP=${PROJECT_BINARY_DIR};XDG_CACHE_HOME=${PROJECT_BINARY_DIR}/cache;XDG_CONFIG_HOME=${PROJECT_BINARY_DIR}/config"
        FAIL_REGULAR_EXPRESSION "Validation Error;SYNC-HAZARD")
endfunction()
function(test_shader target name source)
    set(header "${PROJECT_BINARY_DIR}/generated/$<CONFIG>/${name}.inc")
    add_custom_command(OUTPUT "${header}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${PROJECT_BINARY_DIR}/generated/$<CONFIG>"
        COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c -O
            "${PROJECT_SOURCE_DIR}/${source}" -o "${header}"
        DEPENDS "${source}" shaders/hard_qam.glsl shaders/soft_qam.glsl shaders/soft_quantizer.glsl VERBATIM)
    target_sources(${target} PRIVATE "${header}")
    target_include_directories(${target} PRIVATE "${PROJECT_BINARY_DIR}/generated/$<CONFIG>")
endfunction()

