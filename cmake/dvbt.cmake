# Production has no GNU Radio runtime dependency. References load it in tests.cmake.
option(RADAR_USE_LOCAL_DEPS "Search bootstrap dependencies in build/deps" ON)
if(RADAR_USE_LOCAL_DEPS)
    list(PREPEND CMAKE_PREFIX_PATH "${PROJECT_SOURCE_DIR}/build/deps")
endif()
if(POLICY CMP0167)
    cmake_policy(SET CMP0167 NEW)
endif()
find_package(Boost 1.75 CONFIG REQUIRED)
find_package(Threads REQUIRED)
find_path(FFTW_INCLUDE_DIR fftw3.h REQUIRED)
find_library(RADAR_FFTW_LIBRARY fftw3f REQUIRED)

set(frontend_headers)
foreach(shader spectral_boundary spectral_synth live_unpack)
    set(header "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/${shader}.inc")
    add_custom_command(OUTPUT "${header}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>"
        COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c
            "$<IF:$<CONFIG:Debug>,-g,-O>" "${PROJECT_SOURCE_DIR}/shaders/${shader}.comp" -o "${header}"
        DEPENDS "shaders/${shader}.comp" VERBATIM)
    list(APPEND frontend_headers "${header}")
endforeach()
set(pipeline_headers)
foreach(shader ofdm_window ofdm_pilots ofdm_cp ofdm_frequency stream_copy reencode remap carrier_copy frame_equalize frame_pilots_tiled frame_demap frame_soft_stats frame_phase_scan frame_pilot_align frame_pilot_risk frame_pilot_select frame_soft_noise frame_frequency response_reduce response_fit response_apply noise_variance matched_pack matched_pad matched_product matched_extract matched_prefix matched_prefix_product focus_mean focus_pack focus_shear focus_extract)
    set(header "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/${shader}.inc")
    add_custom_command(OUTPUT "${header}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>"
        COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c
            "$<IF:$<CONFIG:Debug>,-g,-O>" "${PROJECT_SOURCE_DIR}/shaders/${shader}.comp" -o "${header}"
        DEPENDS "shaders/${shader}.comp" VERBATIM)
    if(shader STREQUAL "frame_equalize")
        add_custom_command(OUTPUT "${header}" APPEND DEPENDS shaders/hard_qam.glsl shaders/soft_qam.glsl shaders/soft_quantizer.glsl)
    endif()
    if(shader STREQUAL "frame_pilots_tiled")
        add_custom_command(OUTPUT "${header}" APPEND DEPENDS shaders/pilot_fit.glsl)
    endif()
    list(APPEND pipeline_headers "${header}")
endforeach()
set(response_subgroup_header "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/response_fit_subgroup.inc")
add_custom_command(OUTPUT "${response_subgroup_header}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>"
    COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c -DRADAR_SUBGROUPS
        "$<IF:$<CONFIG:Debug>,-g,-O>" "${PROJECT_SOURCE_DIR}/shaders/response_fit.comp" -o "${response_subgroup_header}"
    DEPENDS shaders/response_fit.comp VERBATIM)
list(APPEND pipeline_headers "${response_subgroup_header}")
add_library(radar_frontend src/dsp.cpp src/gpu_frontend.cpp src/spectral_clock.cpp src/sample_clock.cpp src/live_input.cpp ${frontend_headers})
target_compile_features(radar_frontend PUBLIC cxx_std_23)
set_target_properties(radar_frontend PROPERTIES CXX_EXTENSIONS OFF)
target_include_directories(radar_frontend PUBLIC src PRIVATE "${FFTW_INCLUDE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>")
target_link_libraries(radar_frontend PUBLIC "${RADAR_FFTW_LIBRARY}" Vulkan::Vulkan PRIVATE vkfft_headers)
target_compile_options(radar_frontend PRIVATE -Wall -Wextra -Wpedantic)
add_library(radar_fec src/fec.cpp src/cpu_fec.cpp src/fec_rescue.cpp)
target_compile_features(radar_fec PUBLIC cxx_std_23)
set_target_properties(radar_fec PROPERTIES CXX_EXTENSIONS OFF)
target_include_directories(radar_fec PUBLIC src)
target_compile_options(radar_fec PRIVATE -Wall -Wextra -Wpedantic)
add_library(radar_dsp src/modem.cpp src/gpu_reconstruction.cpp src/gpu_frames.cpp src/frame_decoder.cpp src/gpu_ofdm.cpp src/gpu_receiver.cpp src/gpu_response.cpp src/gpu_pipeline.cpp src/gpu_noise.cpp src/matched_profiles.cpp src/gpu_focus.cpp src/sar_handoff.cpp src/range_doppler.cpp ${pipeline_headers})
target_compile_features(radar_dsp PUBLIC cxx_std_23)
set_target_properties(radar_dsp PROPERTIES CXX_EXTENSIONS OFF)
target_include_directories(radar_dsp PUBLIC src PRIVATE "${FFTW_INCLUDE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>")
target_link_libraries(radar_dsp PUBLIC radar_frontend Boost::headers Threads::Threads "${RADAR_FFTW_LIBRARY}" Vulkan::Vulkan PRIVATE vkfft_headers)
target_link_libraries(radar_dsp PUBLIC radar_fec)
target_compile_options(radar_dsp PRIVATE -Wall -Wextra -Wpedantic)
# DSP callers use explicit finite checks, not libm's errno side effects. This
# allows a shared sin/cos range reduction while retaining IEEE arithmetic.
target_compile_options(radar_dsp PRIVATE "$<$<CXX_COMPILER_ID:GNU,Clang,AppleClang>:-fno-math-errno>")
target_sources(radar_dsp PRIVATE src/matched_detector.cpp src/recording_metadata.cpp)
option(RADAR_BUILD_UHD "Build direct UHD capture front end" ON)
option(RADAR_BUILD_LIVE_DISPLAY "Build optional native ImPlot live map display (macOS)" ON)
option(RADAR_BUILD_TUI "Build interactive capture terminal UI" ON)
option(RADAR_BUILD_USDR "Build PCIe uSDR capture using native CI16 DMA loans" OFF)
set(capture_sources src/capture_source.cpp src/replay_capture.cpp src/live_archive.cpp src/live_capture.cpp src/capture_monitor.cpp src/capture_diagnostics.cpp)
set(capture_libraries)
set(capture_definitions)
if(RADAR_BUILD_UHD)
    find_package(UHD CONFIG REQUIRED)
    list(APPEND capture_sources src/uhd_capture.cpp)
    list(APPEND capture_libraries UHD::uhd)
    list(APPEND capture_definitions RADAR_HAS_UHD)
endif()
if(RADAR_BUILD_USDR)
    find_path(USDR_INCLUDE_DIR dm_stream.h PATH_SUFFIXES usdr REQUIRED)
    find_library(USDR_LIBRARY NAMES usdr REQUIRED)
    include(CheckCXXSourceCompiles)
    set(CMAKE_REQUIRED_INCLUDES "${USDR_INCLUDE_DIR}")
    set(CMAKE_REQUIRED_LIBRARIES "${USDR_LIBRARY}")
    check_cxx_source_compiles("#include <dm_dev.h>
#include <dm_stream.h>
int main(){usdr_dms_rx_block_t b{};return usdr_dms_acquire(nullptr,0,&b)+usdr_dms_release(nullptr,&b);}" USDR_HAS_NATIVE_DMA)
    unset(CMAKE_REQUIRED_INCLUDES)
    unset(CMAKE_REQUIRED_LIBRARIES)
    if(NOT USDR_HAS_NATIVE_DMA)
        message(FATAL_ERROR "uSDR requires the driver branch with native DMA acquire/release")
    endif()
    add_library(radar_usdr_capture STATIC src/usdr_capture.cpp)
    target_include_directories(radar_usdr_capture SYSTEM PRIVATE "${USDR_INCLUDE_DIR}")
    target_link_libraries(radar_usdr_capture PUBLIC radar_frontend PRIVATE "${USDR_LIBRARY}")
    target_compile_options(radar_usdr_capture PRIVATE -Wall -Wextra -Wpedantic)
    list(APPEND capture_libraries radar_usdr_capture)
    list(APPEND capture_definitions RADAR_HAS_USDR)
endif()
add_library(radar_live ${capture_sources})
target_link_libraries(radar_live PUBLIC radar_dsp PRIVATE ${capture_libraries})
target_compile_definitions(radar_live PRIVATE ${capture_definitions})
target_compile_options(radar_live PRIVATE -Wall -Wextra -Wpedantic)
add_executable(dvbt_capture src/capture_main.cpp)
set_target_properties(dvbt_capture PROPERTIES
    INSTALL_RPATH "$<TARGET_FILE_DIR:Vulkan::Vulkan>"
    INSTALL_RPATH_USE_LINK_PATH TRUE)
set_target_properties(radar_live dvbt_capture PROPERTIES CXX_EXTENSIONS OFF)
add_executable(capture_preflight EXCLUDE_FROM_ALL support/live/capture_preflight.cpp)
target_link_libraries(capture_preflight PRIVATE radar_live)
if(RADAR_BUILD_TUI)
    find_package(ftxui 7 CONFIG QUIET)
    if(NOT ftxui_FOUND)
        set(FTXUI_BUILD_DOCS OFF CACHE BOOL "" FORCE)
        set(FTXUI_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
        set(FTXUI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
        set(ftxui_archive "https://codeload.github.com/ArthurSonzogni/FTXUI/tar.gz/f921fad208912747c17d129a8ef75ec7624b6eec")
        if(EXISTS "${PROJECT_SOURCE_DIR}/build/downloads/ftxui.tar.gz")
            set(ftxui_archive "${PROJECT_SOURCE_DIR}/build/downloads/ftxui.tar.gz")
        endif()
        FetchContent_Declare(ftxui URL "${ftxui_archive}"
            URL_HASH SHA256=00e1426f5b13d7748af44925768cca3bc4f64aa3b02e4c82567fd85716911a5b)
        FetchContent_MakeAvailable(ftxui)
    endif()
    add_library(radar_capture_tui support/live/capture_tui.cpp support/live/capture_screen.cpp)
    target_include_directories(radar_capture_tui PUBLIC support/live)
    target_link_libraries(radar_capture_tui PUBLIC radar_live ftxui::component)
    target_compile_options(radar_capture_tui PRIVATE -Wall -Wextra -Wpedantic)
    set_target_properties(radar_capture_tui PROPERTIES CXX_EXTENSIONS OFF)
    target_compile_definitions(dvbt_capture PRIVATE RADAR_TUI)
    target_link_libraries(dvbt_capture PRIVATE radar_capture_tui)
else()
    target_link_libraries(dvbt_capture PRIVATE radar_live)
endif()
set(preview_header "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/preview.inc")
add_custom_command(OUTPUT "${preview_header}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>"
    COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c
        "$<IF:$<CONFIG:Debug>,-g,-O>" "${PROJECT_SOURCE_DIR}/support/video/preview.comp" -o "${preview_header}"
    DEPENDS support/video/preview.comp VERBATIM)
set(history_header "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>/profile_history.inc")
add_custom_command(OUTPUT "${history_header}"
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>"
    COMMAND Vulkan::glslc --target-env=vulkan1.2 -Werror -mfmt=c -O
        "${PROJECT_SOURCE_DIR}/support/video/profile_history.comp" -o "${history_header}"
    DEPENDS support/video/profile_history.comp VERBATIM)
add_library(radar_video_preview STATIC EXCLUDE_FROM_ALL support/video/gpu_preview.cpp support/video/profile_history.cpp "${preview_header}" "${history_header}")
target_include_directories(radar_video_preview PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/$<CONFIG>" PUBLIC support/video)
target_link_libraries(radar_video_preview PUBLIC radar_dsp PRIVATE vkfft_headers)
add_executable(live_profiles_preview EXCLUDE_FROM_ALL support/video/live_profiles_preview.cpp)
target_link_libraries(live_profiles_preview PRIVATE radar_video_preview)
target_compile_options(live_profiles_preview PRIVATE -Wall -Wextra -Wpedantic)
add_executable(simulate_capture EXCLUDE_FROM_ALL support/live/simulate_capture.cpp)
target_link_libraries(simulate_capture PRIVATE radar_dsp)
if(RADAR_BUILD_TUI AND RADAR_BUILD_LIVE_DISPLAY AND APPLE)
    include(support/live/native.cmake)
endif()
include(cmake/tests.cmake)
add_subdirectory(support/validation EXCLUDE_FROM_ALL)

include(GNUInstallDirs)
install(TARGETS dvbt_capture RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}")
install(FILES recordings/live_mt_dandenong.json recordings/live_usdr_mt_dandenong.json
    DESTINATION "${CMAKE_INSTALL_DATADIR}/${PROJECT_NAME}/recordings")
install(FILES README.md THIRD_PARTY.md DESTINATION "${CMAKE_INSTALL_DOCDIR}")
